    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// KI-Antwort auswerten, gegen Regex-Betrag prüfen und Freigabe-Bedarf bestimmen\nconst SCHWELLE = 100; // Freigabegrenze in Euro (zentral anpassbar)\nconst base = $('Betrag ermitteln').first().json;\n\nlet ki = {};\nlet kiFehler = false;\ntry {\n  if ($json.text && typeof $json.text === 'object') {\n    ki = $json.text;                       // Antwort bereits als Objekt\n  } else if (typeof $json.text === 'string' && $json.text.trim() !== '') {\n    const raw = $json.text.replace(/```json|```/g, '').trim();\n    const s = raw.indexOf('{');\n    const e = raw.lastIndexOf('}');\n    ki = JSON.parse(raw.slice(s, e + 1));  // Antwort als Text\n  } else if ($json.lieferant !== undefined || $json.kategorie !== undefined) {\n    ki = $json;                            // Felder direkt im Item (Ollama JSON-Modus)\n  } else {\n    kiFehler = true;                       // keine Antwort -> Fallback\n  }\n} catch (err) {\n  kiFehler = true;\n}\n// Platzhaltertexte aus dem Prompt nicht übernehmen\nif (/^(maximal|höchstens) 2 Sätze/i.test(String(ki.zusammenfassung || ''))) ki.zusammenfassung = '';\nif (/^Name des Rechnungsstellers/i.test(String(ki.lieferant || ''))) ki.lieferant = null;\n\nconst erlaubt = ['Büromaterial', 'IT & Software', 'Reisekosten', 'Dienstleistung', 'Miete & Nebenkosten', 'Marketing', 'Sonstiges'];\nconst kategorie = erlaubt.includes(ki.kategorie) ? ki.kategorie : 'Unklassifiziert';\nconst kiBetrag = (ki.betrag_brutto === null || ki.betrag_brutto === undefined || ki.betrag_brutto === '')\n  ? NaN : Number(String(ki.betrag_brutto).replace(',', '.'));\nconst abweichung = !isNaN(kiBetrag) && base.betrag_gefunden && Math.abs(kiBetrag - base.betrag) > 0.01;\n\nconst hinweise = [];\nif (kiFehler) hinweise.push('KI-Auswertung fehlgeschlagen (Fallback auf Regex)');\nif (!base.betrag_gefunden) hinweise.push('Kein Betrag im Text gefunden');\nif (abweichung) hinweise.push('Betrag weicht ab: Regex ' + base.betrag + ' vs. KI ' + kiBetrag);\nif (!kiFehler && kategorie === 'Unklassifiziert') hinweise.push('Kategorie unklar');\n\nconst freigabeNoetig = base.betrag > SCHWELLE || hinweise.length > 0;\n\nreturn {\n  json: {\n    dateiname: base.dateiname,\n    betrag: base.betrag,\n    lieferant: ki.lieferant || 'unbekannt',\n    rechnungsnummer: ki.rechnungsnummer || 'unbekannt',\n    kategorie: kategorie,\n    zusammenfassung: ki.zusammenfassung || '',\n    hinweise: hinweise.join('; '),\n    ki_fehler: kiFehler,\n    freigabe_noetig: freigabeNoetig\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
