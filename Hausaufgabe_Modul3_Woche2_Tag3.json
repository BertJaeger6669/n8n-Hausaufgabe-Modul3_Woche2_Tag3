      "name": "Text aus Rechnung lesen",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Betrag aus dem Rechnungstext lesen\n// Extract From File (Text) legt den Text meist in \"data\" ab, die PDF-Variante in \"text\"\nconst text = $json.text || $json.data || '';\n\nfunction toNumber(s) {\n  s = s.replace(/\\s/g, '');\n  if (s.includes(',') && s.includes('.')) {\n    if (s.lastIndexOf(',') > s.lastIndexOf('.')) {\n      s = s.replace(/\\./g, '').replace(',', '.');   // 1.234,56\n    } else {\n      s = s.replace(/,/g, '');                       // 1,234.56\n    }\n  } else if (s.includes(',')) {\n    s = s.replace(',', '.');                         // 123,45\n  }\n  return parseFloat(s);\n}\n\nlet betrag = null;\nlet m;\n\n// 1) Stichworte wie Gesamtbetrag, Summe, Total ... -> höchster Treffer (Brutto) gewinnt\nconst keyRegex = /(gesamtbetrag|rechnungsbetrag|gesamtsumme|endbetrag|bruttobetrag|zu zahlen|summe|total)[^\\n]{0,40}?(\\d[\\d.,]*[.,]\\d{2})(?!\\d)/gi;\nwhile ((m = keyRegex.exec(text)) !== null) {\n  const n = toNumber(m[2]);\n  if (!isNaN(n) && (betrag === null || n > betrag)) betrag = n;\n}\n\n// 2) Fallback: größter Betrag mit Euro-Zeichen / EUR\nif (betrag === null) {\n  const euroRegex = /(\\d[\\d.,]*)\\s?(€|EUR)/gi;\n  while ((m = euroRegex.exec(text)) !== null) {\n    const n = toNumber(m[1]);\n    if (!isNaN(n) && (betrag === null || n > betrag)) betrag = n;\n  }\n}\n\nlet dateiname = 'unbekannt';\ntry {\n  dateiname = $('Loop Over Items').first().binary.data.fileName;\n} catch (e) {}\n\nreturn {\n  json: {\n    betrag: betrag === null ? 0 : betrag,\n    betrag_gefunden: betrag !== null,\n    dateiname: dateiname,\n    rechnungsinhalt: text\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        1200
      ],
      "id": "dd976e32-6cda-4695-aebc-30538f3fb206",
      "name": "Betrag ermitteln"
